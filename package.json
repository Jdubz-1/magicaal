{
  "name": "magicaal",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:api":        "pnpm --filter @magicaal/api run dev",
    "dev:engine":     "pnpm --filter @magicaal/engine run dev",
    "dev:web":        "pnpm --filter @magicaal/web run dev",
    "build:api":      "pnpm --filter @magicaal/api run build",
    "build:engine":   "pnpm --filter @magicaal/engine run build",
    "build:web":      "pnpm --filter @magicaal/web run build",
    "build:sdk":      "pnpm --filter @magicaal/sdk-client run build",
    "start:api":      "pnpm --filter @magicaal/api run start",
    "start:engine":   "pnpm --filter @magicaal/engine run start",
    "test:api":       "pnpm --filter @magicaal/api run test",
    "test:engine":    "pnpm --filter @magicaal/engine run test",
    "lint:api":       "pnpm --filter @magicaal/api run lint",
    "lint:engine":    "pnpm --filter @magicaal/engine run lint",
    "type-check:api":    "pnpm --filter @magicaal/api run type-check",
    "type-check:engine": "pnpm --filter @magicaal/engine run type-check",
    "format":         "prettier --write .",
    "build":          "pnpm --recursive run build --if-present"
  }
}
