# MagiCaal — Environment Configuration
# Copy this file to .env and fill in the required values before running docker compose up.
#
# Required: MAGICAAL_MASTER_KEY, JWT_SECRET
# Everything else has safe defaults for a local single-server deployment.

# =============================================================================
# SHARED — used by both api and engine
# =============================================================================

# WARNING: This key is used for AES-256-GCM encryption of all stored integration
# credentials (OAuth tokens, API keys). If you lose this value, you will lose access
# to all stored credentials and will need to reconnect all integrations.
# Generate a secure random value: openssl rand -hex 32
MAGICAAL_MASTER_KEY=

# SQLite database file path — api and engine share the same file via the magicaal_db volume.
# Do not change the path unless you also update the volume mount in docker-compose.yml.
DATABASE_URL=file:/data/magicaal.db

# Separate SQLite file for telemetry (run history, step traces, routing events).
TELEMETRY_DATABASE_URL=file:/data/magicaal-telemetry.db

# JWT secret — signs Studio session tokens; used by both api and web.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Internal API URL — used by web (request proxying) and engine (persisting refreshed
# OAuth tokens; the engine's own DB handle is read-only).
# Do not change if using the api service from this docker-compose.
API_BASE_URL=http://api:3000

# Hosted Marketplace endpoint — used by api (account, catalog, licenses) and engine
# (license heartbeat, usage reporting). Only change this to point at an internal
# staging Marketplace instance.
# MARKETPLACE_API_URL=https://marketplace.magicaal.dev

# =============================================================================
# API (port 3000)
# =============================================================================

API_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Public-facing URL of the API — used for OAuth callback URLs, webhook registration,
# and integration trigger receiver URLs (the endpoints Slack/GitHub/Stripe/etc. events
# are delivered to: /v1/triggers/integrations/<service>/<tenant-slug>).
# Change this to your actual domain when deploying behind a reverse proxy.
PUBLIC_BASE_URL=http://localhost:3000

# Browser origin allowed by CORS — set to the public URL of the web UI when
# deploying behind a reverse proxy / real domain.
# CORS_ORIGIN=http://localhost:8080

# Internal Redis URL — do not change if using the redis service from this docker-compose.
REDIS_URL=redis://redis:6379

# Internal engine URL — do not change if using the engine service from this docker-compose.
ENGINE_BASE_URL=http://engine:4000

# Directory where compiled agent definitions are mounted (from the agent-builder service).
# Do not change unless you also update the volume mount in docker-compose.yml.
AGENTS_DIR=/agents

# Marketplace integration — off by default.
# Set to true only after connecting a MagiCaal Account at marketplace.magicaal.dev.
# When false, all /v1/marketplace/* routes return 503 (except /licenses/bundle).
MARKETPLACE_ENABLED=false

# Air-gapped Marketplace (active regardless of MARKETPLACE_ENABLED).
# Set MARKETPLACE_CATALOG_SOURCE=local to use a locally mounted catalog instead of the
# hosted Marketplace, and mount your catalog directory into the api container
# (see the commented volume on the api service in docker-compose.yml).
# MARKETPLACE_CATALOG_SOURCE=local
# MARKETPLACE_LOCAL_CATALOG_PATH=/marketplace/catalog.json

# =============================================================================
# ENGINE (port 4000)
# =============================================================================

ENGINE_PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Internal engine self-reference URL — used for health checks and inter-service calls.
ENGINE_INTERNAL_URL=http://engine:4000

# Directory where installed Marketplace packages (.mpack) are extracted and loaded from.
# Lives inside the shared /data volume so installed packages persist across restarts.
# Do not change unless you also update the volume mount in docker-compose.yml.
PACKAGES_DIR=/data/packages

# MagiCaal Labs countersignature public key (Ed25519, base64-encoded raw 32 bytes).
# Used to verify the countersignature on official Marketplace packages. Required for
# installs from an internal staging Marketplace and for air-gapped bundles until the
# production key ships pinned in the engine image.
# MAGICAAL_SIGNING_PUBLIC_KEY=

# DANGER: allow installing packages that lack a MagiCaal countersignature.
# Package code runs with full engine privileges — there is no sandbox for community
# packages yet. Leave this false unless you built the package yourself and fully
# trust its source.
MARKETPLACE_ALLOW_UNVERIFIED=false

# =============================================================================
# WEB (port 8080)
# =============================================================================

WEB_PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Internal API URL and JWT_SECRET are defined in the SHARED section above.
