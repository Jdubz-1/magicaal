# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Public base URL used for webhook URLs returned to callers.
# Override in production with the actual API hostname.
PUBLIC_BASE_URL=http://localhost:3000

# Database (SQLite via Drizzle ORM)
DATABASE_URL=file:/data/magicaal.db
TELEMETRY_DATABASE_URL=file:/data/magicaal-telemetry.db

# Queue
REDIS_URL=redis://localhost:6379

# Engine
ENGINE_BASE_URL=http://localhost:4000

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Encryption key for credentials at rest (AES-256).
# Optional in Phase 0; becomes required in Phase 1 before first use of Integration Connections.
# Generate with: openssl rand -hex 32
MAGICAAL_MASTER_KEY=

# Set to true to insert default dev credentials (admin@dev.local / admin) on
# first boot if no platform_admin exists. Never set this in production.
# SEED_ON_BOOT=true

# Graph-as-Code: directory where compiled agent JSON files are mounted.
# In Docker, mount ./dist/agents here. In local dev, point to the agents/ output dir.
AGENTS_DIR=/agents

# Marketplace connectivity.
# Set to true only when a MagiCaal Marketplace account is available.
# Leave false for air-gapped or standalone use — the platform is fully
# functional without it. Air-gapped bundle upload works regardless.
MARKETPLACE_ENABLED=false

# Catalog source: 'remote' (marketplace.magicaal.dev) or 'local' (air-gapped
# catalog.json mounted into the container).
MARKETPLACE_CATALOG_SOURCE=remote
MARKETPLACE_LOCAL_CATALOG_PATH=/marketplace/catalog.json

# Override to point at an internal staging Marketplace during development.
MARKETPLACE_API_URL=https://marketplace.magicaal.dev

# How long invokeCaal polls the engine for a Caal run before returning
# CAAL_STILL_RUNNING instead of the completed response (no SSE — ISS-067/068).
CAAL_INVOKE_TIMEOUT_MS=120000

# ── Rate limiting ────────────────────────────────────────────────────────────
# Window shared by both budgets below.
RATE_LIMIT_WINDOW_MS=900000
# Strict budget for /v1/auth (login, refresh, register), counted together so
# attempts cannot be spread across endpoints to multiply the allowance.
# Credential stuffing is the threat; ten per quarter hour is generous for a
# human and useless for a script.
AUTH_RATE_LIMIT_MAX=10
# Loose budget for the rest of /v1. Exists to stop one client exhausting the
# process, not to police normal use — a busy Studio session makes many calls.
# /internal/* (engine-to-API) and the health route are never limited.
RATE_LIMIT_MAX=600
# What req.ip means, and therefore what the limiter counts. Leave false unless
# this service sits behind a proxy you control. NEVER set `true` behind an
# untrusted hop: a client can then send its own X-Forwarded-For and be counted
# as a new address every request, which is worse than no limiter because the
# service looks protected. Set the number of trusted hops (e.g. `1`) or the
# proxy's address/CIDR instead.
TRUST_PROXY=false
