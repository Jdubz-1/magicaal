# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite — same file as API, shared via volume)
DATABASE_URL=file:/data/magicaal.db
TELEMETRY_DATABASE_URL=file:/data/magicaal-telemetry.db

# Queue
REDIS_URL=redis://localhost:6379

# Encryption key for credentials at rest (AES-256).
# Optional in Phase 0; becomes required in Phase 1 before first use of Integration Connections.
# Generate with: openssl rand -hex 32
MAGICAAL_MASTER_KEY=
