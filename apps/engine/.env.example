# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite — same file as API, shared via volume)
DATABASE_URL=file:/data/magicaal.db
TELEMETRY_DATABASE_URL=file:/data/magicaal-telemetry.db

# Queue
REDIS_URL=redis://localhost:6379

# Encryption key for credentials at rest (AES-256).
# Optional in Phase 0; becomes required in Phase 1 before first use of Integration Connections.
# Generate with: openssl rand -hex 32
MAGICAAL_MASTER_KEY=

# Internal loopback URL for sub-run dispatch (core:sub-graph, core:handoff).
# In Docker use the service name: http://engine:4000
# In local dev the default http://localhost:4000 applies.
ENGINE_INTERNAL_URL=http://engine:4000

# Marketplace connectivity.
# Set to true only when a MagiCaal Marketplace account is available.
# Leave false for air-gapped or standalone use. When false the License
# Validator and Usage Reporter background processes never start.
MARKETPLACE_ENABLED=false
MARKETPLACE_API_URL=https://marketplace.magicaal.dev

# Installing a package runs its code inside the engine. By default only
# MagiCaal-countersigned ('verified') packages install. Set to true ONLY if you
# fully trust every uploaded bundle — unverified self-signed community packages
# are not yet sandboxed and would run with full engine privileges.
MARKETPLACE_ALLOW_UNVERIFIED=false
