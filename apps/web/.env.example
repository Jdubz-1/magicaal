# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Backend API URL (used server-side for SSR/proxy requests)
API_BASE_URL=http://api:3000

# How long the /api proxy waits for the backend. Caal invokes block for the
# whole agent run, so they get their own budget — keep it above the API's
# CAAL_INVOKE_TIMEOUT_MS so the API's own "still running" answer wins the race.
API_TIMEOUT_MS=15000
CAAL_TIMEOUT_MS=125000

# Must match JWT_SECRET in apps/api/.env
JWT_SECRET=change-me-in-production

# Marketplace connectivity — must match the api/engine setting.
# Controls whether the Admin Marketplace panel and Studio "Browse
# Marketplace" links render. Air-gapped package upload works regardless.
MARKETPLACE_ENABLED=false
