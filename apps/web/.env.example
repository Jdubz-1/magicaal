# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Backend API URL (used server-side for SSR/proxy requests)
API_BASE_URL=http://api:3000

# How long the /api proxy waits for the backend. Caal invokes block for the
# whole agent run, so they get their own budget — keep it above the API's
# CAAL_INVOKE_TIMEOUT_MS so the API's own "still running" answer wins the race.
API_TIMEOUT_MS=15000
CAAL_TIMEOUT_MS=125000

# Must match JWT_SECRET in apps/api/.env
JWT_SECRET=change-me-in-production

# Marketplace connectivity — must match the api/engine setting.
# Controls whether the Admin Marketplace panel and Studio "Browse
# Marketplace" links render. Air-gapped package upload works regardless.
MARKETPLACE_ENABLED=false

# ── Rate limiting ────────────────────────────────────────────────────────────
# This app is the layer that sees the real client address: it calls the API
# server-side with no X-Forwarded-For, so the API's per-IP limiter counts every
# browser as this one container. The per-client budget has to live here.
RATE_LIMIT_WINDOW_MS=900000

# Sign-in attempts per window, per client address.
LOGIN_RATE_LIMIT_MAX=10

# Everything else per window. Loose on purpose — an admin clicking through
# pages fans out to several API calls each and must never trip it.
RATE_LIMIT_MAX=600

# What `req.ip` means, and therefore what the limiters count. Leave false
# unless this app is behind a proxy you control: `true` behind an untrusted hop
# lets a client send its own X-Forwarded-For and be counted as a new address on
# every request, which is worse than no limiter because the service looks
# protected. Set the number of trusted hops (e.g. `1`) or the proxy's address.
TRUST_PROXY=false
