#!/usr/bin/env bash
#
# commit-msg — reject any commit message carrying AI attribution.
#
# CLAUDE.md forbids AI/model attribution in commit messages absolutely. This
# hook enforces that locally so a bad trailer never reaches history, where
# removing it costs a force-push.
#
# Design note: this repository legitimately talks about AI vendors and models
# all the time — provider adapters for OpenAI/Anthropic/Gemini, the Model
# Router, the built-in Caal assistant. So the patterns below anchor on
# *attribution constructs* (trailers, "generated by X"), never on a bare model
# name. `feat(engine): add Gemini provider adapter` must pass; only text that
# credits a model as an author is rejected.
#
# Install: `git config core.hooksPath .githooks` (the root package.json
# `prepare` script does this automatically on `pnpm install`).

set -euo pipefail

msg_file="${1:?commit-msg hook requires the message file path}"

# Scan what git will actually keep: drop comment lines, and everything below
# the `git commit --verbose` scissors line (which contains the full diff and
# would otherwise match on any diff of this very hook).
content="$(sed -e '/^# *-\{1,\} *>8 *-\{1,\}/,$d' -e '/^#/d' "$msg_file")"

# Model and vendor names, matched only inside an attribution construct below.
ai='claude|anthropic|chatgpt|openai|gpt-?[0-9]|copilot|gemini|bard|llama|mistral|cursor|codeium|windsurf|devin|aider|tabnine|codewhisperer|amazon q|replit agent|sourcegraph cody|opus|sonnet|haiku|ai assistant|artificial intelligence|large language model|\bllm\b'

violations=()

check() {
  local pattern="$1" label="$2" hits
  hits="$(printf '%s\n' "$content" | grep -nEi -- "$pattern" || true)"
  [ -n "$hits" ] && violations+=("$label|$hits")
  return 0
}

# 1. Co-author style trailers crediting a model. A human co-author is fine —
#    only the AI-named variant is rejected.
check "^[[:space:]]*co-(authored|committed)-by:.*($ai)" "AI co-author trailer"

# 2. Trailers that exist only to link an AI session or credit a tool.
check "^[[:space:]]*(claude|ai|llm|assistant|agent)-(session|thread|conversation):" "AI session trailer"
check "^[[:space:]]*(assisted-by|ai-assisted-by|generated-by|written-by|created-by):.*($ai)" "AI assistance trailer"

# 3. Prose crediting a model as the author of the work.
check "(generated|created|written|authored|produced|made)[[:space:]]+(with|by|using)[[:space:]]+[^[:space:]]*($ai)" "AI generation credit"

# 4. Vendor bot addresses that only appear in machine-authored trailers.
check "noreply@anthropic\.com|@openai\.com|copilot(\[bot\])?@|bot@anthropic" "AI bot address"

# 5. The robot emoji is only ever used here as a "generated with" marker.
check $'\U0001F916' "robot emoji (generated-with marker)"

if [ ${#violations[@]} -eq 0 ]; then
  exit 0
fi

printf '\n\033[31mCommit rejected: AI attribution found in the commit message.\033[0m\n\n'
for v in "${violations[@]}"; do
  label="${v%%|*}"
  lines="${v#*|}"
  printf '  %s:\n' "$label"
  printf '%s\n' "$lines" | sed 's/^/    line /'
done

cat <<'EOF'

CLAUDE.md forbids AI or model attribution in commit messages under any
circumstance. Remove the offending line(s) and commit again.

Commits carry exactly one trailer: the DCO sign-off for the human author.

    git commit -s -m "type(scope): subject"

If you are describing this rule rather than invoking it, paraphrase instead of
quoting the literal trailer — the scan cannot tell the two apart.
EOF

exit 1
