{
  "name": "@magicaal/nodes",
  "version": "0.6.0",
  "description": "MagiCaal built-in node implementations",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
