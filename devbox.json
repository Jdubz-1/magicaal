{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "nodejs@24",
    "pnpm@9"
  ],
  "shell": {
    "init_hook": [
      "[ ! -d node_modules ] && pnpm install || true"
    ],
    "scripts": {
      "dev":        "pnpm --filter @magicaal/api run dev",
      "build":      "pnpm --filter @magicaal/api run build",
      "test":       "pnpm --filter @magicaal/api run test",
      "test:cov":   "pnpm --filter @magicaal/api run test:cov",
      "lint":       "pnpm --filter @magicaal/api run lint",
      "type-check": "pnpm --filter @magicaal/api run type-check",
      "format":     "pnpm run format",
      "setup":      "pnpm install",
      "magicaal":   "node packages/cli/dist/index.js"
    }
  }
}
